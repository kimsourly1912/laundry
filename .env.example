# Copy to .env for local development. Deployed environments set these as Worker secrets/vars (spec §14).

# Better Auth (M1.4): a distinct secret of at least 32 high-entropy characters per environment.
NUXT_BETTER_AUTH_SECRET=

# The site's public address. Required for Better Auth on Cloudflare Workers.
# NUXT_PUBLIC_SITE_URL=https://your-domain.example

# Telegram (M4): the platform bot. Without a token Telegram is off.
# NUXT_TELEGRAM_BOT_TOKEN=        # from @BotFather, a secret
# NUXT_TELEGRAM_BOT_USERNAME=     # without @
# NUXT_TELEGRAM_WEBHOOK_SECRET=   # 32–256 letters, digits, _ or -

# The first platform admin (seed task only, M1.4). The seed refuses if a super admin already exists.
# NUXT_PLATFORM_ADMIN_USERNAME=
# NUXT_PLATFORM_ADMIN_PASSWORD=
