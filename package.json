{
  "name": "laundry",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project server",
    "test:changed": "vitest run --project unit --project server --changed origin/main",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "0.10.12",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "valibot": "^1.5.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@vue/test-utils": "^2.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
